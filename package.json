	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bagude/arbiter.git"
	},
	"homepage": "https://github.com/bagude/arbiter#readme",
	"bugs": {
		"url": "https://github.com/bagude/arbiter/issues"
	},
	"keywords": [
		"agents",
		"llm",
		"harness",
		"coding-agent",
		"multi-agent",
		"evaluation",
		"pi"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
